{
  "info": {
    "name": "Student Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "studentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Add student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/students",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Asha Rao\",\n  \"email\": \"asha@example.com\",\n  \"course\": \"Java\",\n  \"age\": 21\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) { pm.collectionVariables.set(\"studentId\", pm.response.json().id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Retrieve all students",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/students"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Returns an array\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Retrieve student by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/students/{{studentId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Retrieve students by course",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/students/course/Java"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Contains created student\", () => pm.expect(pm.response.json().some(s => String(s.id) === String(pm.collectionVariables.get(\"studentId\")))).to.be.true);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Update student",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/students/{{studentId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Asha Rao\",\n  \"email\": \"asha@example.com\",\n  \"course\": \"Python\",\n  \"age\": 22\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Course updated\", () => pm.expect(pm.response.json().course).to.eql(\"Python\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Invalid email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/students",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Asha Rao\",\n  \"email\": \"invalid\",\n  \"course\": \"Java\",\n  \"age\": 21\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Delete student",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/students/{{studentId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Confirm student not found",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/students/{{studentId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}
